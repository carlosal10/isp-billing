{
  "name": "isp-billing",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "framer-motion": "^12.23.12",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "mongoose": "^8.18.0",
    "node-cron": "^4.2.1",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.4",
    "routeros-client": "^1.1.2",
    "socket.io": "^4.8.1",
    "stripe": "^18.4.0",
    "web-vitals": "^2.1.4",
    "zod": "^4.1.5"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:server": "node --test server/tests/*.test.js",
    "start:server": "node server/App.js",
    "ci:server": "npm run env:check && npm run api:contract:audit && npm run security:routes:audit && npm run privacy:policy:audit && npm run test:server",
    "ci:client": "node scripts/run-client-ci.js",
    "migrate:status": "node server/scripts/run-migrations.js --status",
    "migrate:dry": "node server/scripts/run-migrations.js",
    "migrate": "node server/scripts/run-migrations.js --write",
    "db:indexes:audit": "node server/scripts/audit-indexes.js",
    "api:contract:audit": "node server/scripts/audit-api-contract.js",
    "security:routes:audit": "node server/scripts/audit-route-security.js",
    "privacy:policy:audit": "node server/scripts/audit-privacy-policy.js",
    "privacy:retention:plan": "node server/scripts/run-privacy-retention.js",
    "privacy:retention": "node server/scripts/run-privacy-retention.js --write",
    "env:check": "node server/scripts/check-env.js",
    "backup:mongo:plan": "node server/scripts/backup-mongo.js",
    "backup:mongo": "node server/scripts/backup-mongo.js --write",
    "restore:mongo:plan": "node server/scripts/restore-mongo.js",
    "restore:mongo": "node server/scripts/restore-mongo.js --write --confirm-restore",
    "secrets:encrypt:plan": "node server/scripts/encrypt-configuration-secrets.js",
    "secrets:encrypt": "node server/scripts/encrypt-configuration-secrets.js --write",
    "secrets:rotate": "node server/scripts/encrypt-configuration-secrets.js --write --rotate",
    "migrate:finance:dry": "node -e \"process.env.DRY_RUN='1'; require('./server/migrations/2026-04-27-backfill-finance-core.js')\"",
    "migrate:finance": "node -e \"process.env.DRY_RUN='0'; require('./server/migrations/2026-04-27-backfill-finance-core.js')\"",
    "migrate:payments:dry": "node -e \"process.env.DRY_RUN='1'; require('./server/migrations/2025-09-28-normalize-payments.js')\"",
    "migrate:payments": "node -e \"process.env.DRY_RUN='0'; require('./server/migrations/2025-09-28-normalize-payments.js')\"",
    "test:integration": "node --test server/integration/*.test.js",
    "staging:local": "node scripts/local-staging.js",
    "test:browser": "playwright test",
    "security:dependencies": "npm audit --audit-level=high",
    "test:restore": "node scripts/verify-restore.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
